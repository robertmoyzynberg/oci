# Local defaults. Render injects PORT automatically — do not hardcode it in production.
PORT=8000

# Optional: comma-separated origins, or * for MVP
CORS_ORIGINS=*

# Feedback email recipient (defaults to rizim13@gmail.com)
FEEDBACK_TO=rizim13@gmail.com

# Preferred: Resend API key (https://resend.com). Required for server-side /feedback.
# Without it, the frontend falls back to browser FormSubmit (one-time inbox activation).
# RESEND_API_KEY=re_xxxxxxxx
# Optional verified sender after you add a domain in Resend:
# FEEDBACK_FROM=OCI Converge <feedback@yourdomain.com>
